import random
import math
def isitprime(a):
    if a <= 1:
        return True
    if a == 2:
        return True
    if a % 2 == 0:
        return False
    sqrt = int(math.sqrt(a))

    for i in range(3, sqrt + 1, 2):
        if a % i == 0:
            return False
        
    return True

number = random.randint(1, 1000000)

if isitprime(number):
    print (f"{number} is prime, yay")
else:
    print (f"{number}'s composite")

    
